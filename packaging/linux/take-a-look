#!/usr/bin/env bash
set -euo pipefail

app_root="$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")"
backend="$app_root/backend/runtime/take_a_look_backend/take_a_look_backend"
# System installations are read-only to desktop users. Both the UI and direct
# backend launches must write journals to the same per-user writable location.
if [[ -z "${TAL_RECORDINGS_DIR:-}" && ! -w "$app_root" ]]; then
  data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  [[ "$data_home" == /* ]] || data_home="$HOME/.local/share"
  export TAL_RECORDINGS_DIR="$data_home/take-a-look/recordings"
fi

check_platform() {
  local expected_arch minimum_glibc actual_glibc
  read -r expected_arch minimum_glibc < "$app_root/runtime-requirements"
  if [[ "$(uname -m)" != "$expected_arch" ]]; then
    echo "This package needs $expected_arch; this computer is $(uname -m)." >&2
    return 1
  fi
  actual_glibc="$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}' || true)"
  if [[ -z "$actual_glibc" ]] ||
     [[ "$(printf '%s\n' "$minimum_glibc" "$actual_glibc" | sort -V | head -n1)" != "$minimum_glibc" ]]; then
    echo "This package needs glibc >= $minimum_glibc (found ${actual_glibc:-none})." >&2
    return 1
  fi
}

check_libraries() {
  local report
  if ! report="$(LC_ALL=C ldd "$app_root/take_a_look_v2" 2>&1)" ||
     [[ "$report" == *'not found'* ]]; then
    printf '%s\n' "$report" >&2
    echo "Install desktop dependencies: $app_root/install-deps.sh" >&2
    return 1
  fi
}

case "${1:-}" in
  --help|-h)
    echo 'Usage: take-a-look [--doctor | --check-libs | --backend | --software-rendering]'
    exit 0 ;;
  --check-platform)
    check_platform
    exit 0 ;;
  --check-libs)
    check_platform
    check_libraries
    exit 0 ;;
  --doctor)
    check_platform
    check_libraries
    timeout 30 "$backend" --self-test
    echo 'Runtime check passed. USB hardware access and graphics need a desktop session.'
    exit 0 ;;
  --backend)
    shift
    check_platform
    exec "$backend" "$@" ;;
  --software-rendering)
    export LIBGL_ALWAYS_SOFTWARE=1 TAKE_A_LOOK_GPU=system
    shift ;;
esac

check_platform
check_libraries
if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  echo 'No graphical session found. Start from a Linux desktop or WSLg.' >&2
  exit 1
fi
# Prefer the native transport for this session. GDK can fall back when the
# advertised Wayland socket is unavailable; an explicit override is preserved.
if [[ -z "${GDK_BACKEND:-}" ]]; then
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    export GDK_BACKEND=wayland,x11
  elif [[ -n "${DISPLAY:-}" ]]; then
    export GDK_BACKEND=x11
  fi
fi
export TAKE_A_LOOK_BACKEND_DIR="${TAKE_A_LOOK_BACKEND_DIR:-$app_root/backend}"
exec "$app_root/take_a_look_v2" "$@"
